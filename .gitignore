# UV 관련
.venv/
__pycache__/
*.pyc
.python-version

# 환경 변수 파일
.env

# 엔진 상태 DB / 락 파일 (개인 실행 상태, 공유하면 안 됨)
# data/ 자체가 아니라 data/*로 걸어야 아래 부정(!) 패턴이 적용된다 (디렉토리 자체를
# 무시하면 git이 안으로 순회하지 않아 하위 파일 단위 예외가 먹히지 않음).
data/*
# 단, 종목 발굴 후보 유니버스 시드는 커밋 대상 (런타임 상태가 아니라 소스 데이터)
!data/candidate_universe_seed.json

# 엔진 실행 로그 (uvicorn stdout을 tee/리다이렉트로 남긴 것, 개인 실행 기록)
logs_*.log